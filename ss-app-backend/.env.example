PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# ── ERP ───────────────────────────────────────────────────────────────────
# Clave anon (publishable) del proyecto: la usa el backend para pedir correos de recuperación de contraseña
SUPABASE_ANON_KEY=
# false para desactivar la detección de anomalías programada (tests / local)
ERP_SCHEDULER=true
